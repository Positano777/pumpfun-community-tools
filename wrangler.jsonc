{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rughawk",
  // Custom entrypoint: wraps the OpenNext handler with rate limiting and the
  // Watchtower cron (worker/index.js imports .open-next/worker.js: build first).
  "main": "worker/index.js",
  // >= 2026-03-27 for the AI Search namespace binding, >= 2026-03-24 for
  // Browser Run quickAction(). Pinned to the newest date the workerd shipped
  // with wrangler 4.126 supports, so `wrangler dev` runs the same semantics.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,

  // Attach once the domain is on Cloudflare (buy rughawk.com, add the zone):
  // "routes": [
  //   { "pattern": "rughawk.com", "custom_domain": true },
  //   { "pattern": "www.rughawk.com", "custom_domain": true }
  // ],

  "observability": { "enabled": true },

  // Watchtower: re-scan the watchlist every 10 minutes (worker/index.js).
  "triggers": { "crons": ["*/10 * * * *"] },

  // Required by OpenNext for features that re-enter the worker.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rughawk" }],

  "r2_buckets": [
    // Next.js incremental cache.
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "rughawk-next-cache" },
    // Report snapshots (JSON evidence trail) and Browser Run screenshots.
    { "binding": "REPORTS", "bucket_name": "rughawk-reports" }
  ],

  // Report cache, metadata JSON, RDAP and first-funding lookups.
  "kv_namespaces": [{ "binding": "CACHE", "id": "2cce5391ef7049b18e36587950e4b1d3" }],

  // Scan history, deployer linkage, feed, watchlist, alerts.
  "d1_databases": [
    { "binding": "DB", "database_name": "rughawk-db", "database_id": "2e0e05f9-f02d-4c57-971d-edb5d1d8c89a" }
  ],

  // Scam DNA: 768-dim bge-base-en-v1.5 embeddings of every token's identity.
  // Create once: npx wrangler vectorize create rughawk-dna --dimensions=768 --metric=cosine
  "vectorize": [{ "binding": "DNA", "index_name": "rughawk-dna" }],

  // Workers AI: Llama 4 Scout (verdicts, copilot, vision), Llama 3.3 70B
  // (fallback), Llama Guard 3 + Prompt Guard 2 (copilot guardrails),
  // bge-base-en-v1.5 (Scam DNA), Deepgram Aura (spoken verdicts), plus the
  // Web Search API. Every call is routed through AI Gateway (AI_GATEWAY_ID).
  "ai": { "binding": "AI" },

  // Browser Run: renders token websites (markdown + screenshot) for the
  // drainer-lure review.
  "browser": { "binding": "BROWSER" },

  // AI Search: the Hawk Playbook knowledge base for the copilot. The instance
  // is created and filled by POST /api/admin/setup (built-in storage).
  "ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "default" }],

  // Edge rate limits, enforced in worker/index.js. Namespace ids are distinct
  // from Solmint's (1001-1004) so the two apps never share counters.
  "ratelimits": [
    { "name": "RL_SCAN", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "2002", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_RPC", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_API", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } }
  ],

  // Secrets (never in this file): npx wrangler secret put <NAME>
  //   QUICKNODE_RPC_URL   dedicated RugHawk Solana mainnet endpoint (primary)
  //   HELIUS_RPC_URL      optional failover
  //   ANKR_RPC_URL        optional failover
  //   ADMIN_TOKEN         protects /api/admin/*
  //   CRON_SECRET         authenticates the Watchtower cron call
  "vars": {
    // Switch to https://rughawk.com (here and in .env.production) once the
    // domain is on Cloudflare and the routes above are enabled.
    "NEXT_PUBLIC_APP_URL": "https://rughawk.plain-forest-6a44.workers.dev",
    // `default` is created automatically by AI Gateway on first use. For
    // per-app logs, caching, Guardrails and a spend limit, create a gateway
    // named `rughawk-ai` (dashboard: AI > AI Gateway) and put its id here.
    "AI_GATEWAY_ID": "default",
    "AI_SEARCH_INSTANCE": "rughawk-playbook",
    // Web Search API is beta and billed per query through AI Gateway credits.
    "WEB_SEARCH": "off"
  }
}
